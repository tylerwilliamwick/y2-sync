{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "file",
          "line",
          "evidence",
          "recommendedFix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "maxLength": 500
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          },
          "recommendedFix": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
